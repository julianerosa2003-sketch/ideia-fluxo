rules_version = '2';

// Publicadas automaticamente com:  firebase.cmd deploy
// (ou cole em: Firebase Console → Firestore Database → Regras → Publicar)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function str(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    // Campos comuns às três organizações
    function validCommon(d, ideaId) {
      return d.id == ideaId
        && d.kind in ['projeto', 'livro', 'estampa']
        && d.prioridade in ['Alta', 'Média', 'Baixa']
        && str(d.status, 1, 40)
        && d.createdAt is int && d.updatedAt is int;
    }

    function validProjeto(d) {
      return d.keys().hasOnly(['id', 'kind', 'prioridade', 'status', 'createdAt', 'updatedAt',
                               'nome', 'objetivo', 'composicao', 'tipo', 'linguagem'])
        && str(d.nome, 1, 120)
        && str(d.objetivo, 1, 5000)
        && str(d.composicao, 1, 5000)
        && str(d.tipo, 1, 40)
        && str(d.linguagem, 1, 40);
    }

    function validLivro(d) {
      return d.keys().hasOnly(['id', 'kind', 'prioridade', 'status', 'createdAt', 'updatedAt',
                               'titulo', 'genero', 'sinopse', 'capitulos'])
        && str(d.titulo, 1, 150)
        && str(d.genero, 1, 40)
        && str(d.sinopse, 1, 5000)
        && (d.capitulos == null || (d.capitulos is int && d.capitulos >= 0 && d.capitulos <= 1000));
    }

    function validEstampa(d) {
      return d.keys().hasOnly(['id', 'kind', 'prioridade', 'status', 'createdAt', 'updatedAt',
                               'genero', 'objetos', 'descricao', 'cores'])
        && str(d.genero, 1, 60)
        && str(d.objetos, 1, 300)
        && str(d.descricao, 1, 5000)
        && d.cores is list && d.cores.size() <= 20;
    }

    function validIdea(ideaId) {
      let d = request.resource.data;
      return validCommon(d, ideaId)
        && ((d.kind == 'projeto' && validProjeto(d))
         || (d.kind == 'livro' && validLivro(d))
         || (d.kind == 'estampa' && validEstampa(d)));
    }

    // Cada usuário só lê/escreve as próprias ideias. Todo o resto é negado.
    match /users/{uid}/ideas/{ideaId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validIdea(ideaId);
    }
  }
}
